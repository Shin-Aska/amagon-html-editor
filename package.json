{
  "name": "hoarses-html-editor",
  "version": "1.11.1",
  "description": "Amagon — Offline Visual HTML Editor (Pingendo/Mobirise Alternative)",
  "homepage": "https://www.amagon.app/",
  "author": "Shin-Aska <Orillarichard@pm.me>",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/electron-vite-dev.mjs",
    "dev:web": "vite --config vite.config.ts",
    "build": "electron-vite build",
    "build:web": "tsc -b && vite build --config vite.config.ts",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:e2e:electron": "playwright test --config playwright.electron.config.ts",
    "test:e2e:ownership": "node --import tsx --test tests/electron/processOwnership.test.ts",
    "test:e2e:release": "playwright test --config playwright.electron.config.ts project-assets.spec.ts widget-experience.spec.ts app-appearance-code.spec.ts canvas-code-layout.spec.ts canvas-code-selection.spec.ts",
    "test:e2e:browser": "playwright test --config playwright.browser.config.ts",
    "test:watch": "vitest",
    "generate:fonts": "npx tsx scripts/generate-google-fonts-catalog.ts",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@opencode-ai/sdk": "^1.19.5",
    "@zip.js/zip.js": "^2.24.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "fflate": "^0.8.3",
    "font-list": "^2.1.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.70.0",
    "monaco-editor": "^0.54.0",
    "parse5": "^8.1.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.19.1",
    "tailwindcss": "^3.4.19",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.11.18",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "minimatch": "^11.0.5",
    "esbuild": "0.28.1",
    "monaco-editor": {
      "dompurify": "^3.4.17"
    }
  },
  "build": {
    "appId": "com.hoarses.editor",
    "productName": "Amagon HTML Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "assets/**/*"
    ],
    "mac": {
      "icon": "assets/app.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "icon": "assets/app.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/app.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development"
    },
    "publish": {
      "provider": "github",
      "owner": "Shin-Aska",
      "repo": "amagon-html-editor",
      "releaseType": "draft"
    }
  },
  "allowScripts": {
    "electron@42.11.18": true,
    "esbuild@0.28.1": true
  }
}
